# Copia este fichero como .env (en la carpeta entrega/) y rellena los valores.
# El .env esta en el .gitignore: no lo subas nunca.

# Clave de Gemini (https://aistudio.google.com/apikey) para la respuesta documental
GOOGLE_API_KEY=

# Segundos maximos de espera al LLM antes de responder con el mensaje de respaldo.
# Dialogflow corta a los 5 s, y el tunel y Dialogflow se comen ~0,5-1 s.
LLM_TIMEOUT=4

# Modelo de Gemini. Uno "flash-lite" responde en ~1 s; los "flash" grandes
# a veces tardan mas de 5 s (o dan 503 por demanda) y Dialogflow corta.
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelos de respaldo (separados por comas). La pregunta se lanza a la vez al
# principal y a estos, y se usa la primera respuesta.
GEMINI_MODELOS_RESPALDO=gemini-3.1-flash-lite
# Segundos que se espera a Gemini antes de conformarse con la respuesta local
LLM_ESPERA_PREFERIDO=2.5

# Modelo local de Ollama que compite con Gemini (vacio = sin modelo local).
# Instalacion: https://ollama.com y despues `ollama pull qwen2.5:3b`
LLM_LOCAL=ollama:qwen3.5:9b-q8_0
OLLAMA_URL=http://localhost:11434
# Cada cuantos segundos se hace una llamada minima para mantener la conexion
# caliente y el modelo local cargado en la GPU (0 = desactivado)
LLM_KEEPALIVE=60

# Proyecto de Google Cloud del agente y clave JSON de la cuenta de servicio
# (rol "Dialogflow API Client"), solo para el cliente de voz
DIALOGFLOW_PROJECT_ID=proyecto-aseguradora-api
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\a\clave.json

# 1 = respuestas en SSML para la voz; 0 = texto plano (simulador, Messenger)
SSML=1
